PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.example.mongodb.net/orderbridge?retryWrites=true&w=majority
# MONGODB_URL and MONGO_URL are also supported for compatibility.

# Optional: use this when mongodb+srv Atlas DNS lookup fails locally.
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
DEBUG_DB_ERRORS=false

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

HERMES_API_BASE_URL=
HERMES_API_URL=
HERMES_AGENT_URL=
HERMES_API_KEY=
HERMES_TIMEOUT_MS=45000
HERMES_AGENT_MODEL=hermes-agent
MCP_SHARED_SECRET=

# AI provider selection. Use hermes for rollback or openrouter for the local tool-calling agent.
AI_PROVIDER=hermes
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_TIMEOUT_MS=45000
OPENROUTER_MAX_TOOL_ROUNDS=6
OPENROUTER_MAX_OUTPUT_TOKENS=800
OPENROUTER_CUSTOMER_AGENT_ENABLED=false
OPENROUTER_CUSTOMER_LEGACY_FALLBACK=false
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=OrderBridgeAI

WASENDER_API_URL=https://www.wasenderapi.com
WASENDER_API_KEY=
WASENDER_WEBHOOK_SECRET=
APP_PUBLIC_URL=

# Transactional post-order feedback workflow.
ORDER_FEEDBACK_DELAY_MINUTES=120
ORDER_FEEDBACK_REMINDER_HOURS=12
ORDER_AUTO_COMPLETE_HOURS=24
